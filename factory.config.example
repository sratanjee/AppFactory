# App Factory — fleet config template
# Copy to factory.config (gitignored) and fill in the values. Optional
# per-machine overrides go in factory.config.local (also gitignored,
# merged on top of factory.config by the loader).

# ---- Identity ----
BUNDLE_PREFIX=com.appfactory
STUDIO_DISPLAY_NAME="App Factory"

# ---- Toolchain ----
FLUTTER_VERSION=3.47.4
DART_MIN=3.13.0

# ---- Developer accounts ----
# A is live. B and C are stubs; add when Apple / Google accounts exist.
DEV_ACCOUNT_A_LABEL=""
DEV_ACCOUNT_A_TEAM_ID=""
DEV_ACCOUNT_A_ASC_TEAM_ID=""
DEV_ACCOUNT_A_ASC_ISSUER_ID=""
DEV_ACCOUNT_A_ASC_KEY_ID=""
# Absolute path to the .p8 file downloaded from ASC. Keep the file outside
# the repo (~/.keys/ is a good spot).
DEV_ACCOUNT_A_ASC_KEY_PATH=""
# Absolute path to the Play Developer API service-account JSON.
DEV_ACCOUNT_A_PLAY_SERVICE_ACCOUNT_JSON=""
# Package prefix used when tools/monetize creates Play products
# (com.<studio>). Usually matches BUNDLE_PREFIX.
DEV_ACCOUNT_A_PLAY_PACKAGE_PREFIX=""
DEV_ACCOUNT_A_PLAY_PACKAGE_ACCOUNT_JSON=""

DEV_ACCOUNT_B_LABEL=""
DEV_ACCOUNT_B_TEAM_ID=""
DEV_ACCOUNT_B_ASC_TEAM_ID=""
DEV_ACCOUNT_B_ASC_ISSUER_ID=""
DEV_ACCOUNT_B_ASC_KEY_ID=""
DEV_ACCOUNT_B_ASC_KEY_PATH=""
DEV_ACCOUNT_B_PLAY_SERVICE_ACCOUNT_JSON=""
DEV_ACCOUNT_B_PLAY_PACKAGE_PREFIX=""
DEV_ACCOUNT_B_PLAY_PACKAGE_ACCOUNT_JSON=""

DEV_ACCOUNT_C_LABEL=""
DEV_ACCOUNT_C_TEAM_ID=""
DEV_ACCOUNT_C_ASC_TEAM_ID=""
DEV_ACCOUNT_C_ASC_ISSUER_ID=""
DEV_ACCOUNT_C_ASC_KEY_ID=""
DEV_ACCOUNT_C_ASC_KEY_PATH=""
DEV_ACCOUNT_C_PLAY_SERVICE_ACCOUNT_JSON=""
DEV_ACCOUNT_C_PLAY_PACKAGE_PREFIX=""
DEV_ACCOUNT_C_PLAY_PACKAGE_ACCOUNT_JSON=""

# ---- RevenueCat ----
REVENUECAT_PROJECT_ID=""
REVENUECAT_API_V2_TOKEN=""
REVENUECAT_IOS_PUBLIC_KEY=""
REVENUECAT_ANDROID_PUBLIC_KEY=""

# ---- Mixpanel (per-app opt-in) ----
# Only apps whose spec calls for Mixpanel instead of the factory default.
# MIXPANEL_PROJECT_<slug>=""
# MIXPANEL_TOKEN_<slug>=""

# ---- Google Maps (per-app opt-in) ----
# GOOGLE_MAPS_WEB_KEY_<slug>=""
# GOOGLE_MAPS_IOS_KEY_<slug>=""
# GOOGLE_MAPS_ANDROID_KEY_<slug>=""

# ---- Web deploy (per-app opt-in) ----
# WEB_DEPLOY_DOMAIN_<slug>=""
# WEB_DEPLOY_PROVIDER_<slug>=""   # vercel | firebase

# ---- Shorebird ----
SHOREBIRD_ORG=""
SHOREBIRD_TOKEN=""

# ---- Codemagic ----
CODEMAGIC_TEAM_ID=""
CODEMAGIC_API_TOKEN=""

# ---- Shared backend ----
BACKEND_BASE_URL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-opus-4-7"

# ---- Store metadata seeds ----
DEFAULT_SUPPORT_URL=""
DEFAULT_PRIVACY_URL=""
DEFAULT_MARKETING_URL=""

# ---- Privacy site ----
# Scaffolds derive each app's privacy URL as <base>/<slug>/privacy.html.
# Reference site: https://sratanjee.github.io/appfactory-site
PRIVACY_URL_BASE=""
