# App Factory — fleet config
# Loaded by tools/scaffold, tools/monetize, backend, and CI.
# Everything here is checked in. Real secrets live in factory.config.local (gitignored).
# To override any value locally without touching this file, create factory.config.local
# and export the same variables — the scaffolder sources this first, then .local.

# ---- Identity ----
BUNDLE_PREFIX=com.appfactory
STUDIO_DISPLAY_NAME="App Factory"

# ---- Toolchain ----
FLUTTER_VERSION=3.47.4
DART_MIN=3.13.0

# ---- Developer accounts ----
# A is the live account. B and C are stubs; add when Apple / Google accounts exist.
DEV_ACCOUNT_A_LABEL=""
DEV_ACCOUNT_A_ASC_TEAM_ID=""
DEV_ACCOUNT_A_ASC_ISSUER_ID=""
DEV_ACCOUNT_A_ASC_KEY_ID=""
DEV_ACCOUNT_A_PLAY_PACKAGE_ACCOUNT_JSON=""

DEV_ACCOUNT_B_LABEL=""
DEV_ACCOUNT_B_ASC_TEAM_ID=""
DEV_ACCOUNT_B_ASC_ISSUER_ID=""
DEV_ACCOUNT_B_ASC_KEY_ID=""
DEV_ACCOUNT_B_PLAY_PACKAGE_ACCOUNT_JSON=""

DEV_ACCOUNT_C_LABEL=""
DEV_ACCOUNT_C_ASC_TEAM_ID=""
DEV_ACCOUNT_C_ASC_ISSUER_ID=""
DEV_ACCOUNT_C_ASC_KEY_ID=""
DEV_ACCOUNT_C_PLAY_PACKAGE_ACCOUNT_JSON=""

# ---- RevenueCat ----
# No project yet. Filled in when the RC account is created. See QUESTIONS.md.
REVENUECAT_PROJECT_ID=""
REVENUECAT_API_V2_TOKEN=""
REVENUECAT_IOS_PUBLIC_KEY=""
REVENUECAT_ANDROID_PUBLIC_KEY=""

# ---- Shorebird (code push) ----
SHOREBIRD_ORG=""
SHOREBIRD_TOKEN=""

# ---- Codemagic (CI) ----
CODEMAGIC_TEAM_ID=""
CODEMAGIC_API_TOKEN=""

# ---- Shared backend / AI proxy ----
# One backend for the whole fleet. Claude only, via Anthropic.
BACKEND_BASE_URL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-opus-4-7"

# ---- Store metadata seeds ----
DEFAULT_SUPPORT_URL=""
DEFAULT_PRIVACY_URL=""
DEFAULT_MARKETING_URL=""
